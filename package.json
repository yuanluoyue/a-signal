{
  "name": "a-signal",
  "version": "1.0.0",
  "description": "A Signal - 股票分析系统",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter backend run start:dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:docker": "docker-compose -f docker/docker-compose.dev.yml up -d",
    "dev:docker:down": "docker-compose -f docker/docker-compose.dev.yml down",
    "build:backend": "pnpm --filter backend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "format": "pnpm --filter backend run format",
    "lint": "pnpm --filter backend run lint",
    "test:backend": "pnpm --filter backend run test",
    "test:e2e:backend": "pnpm --filter backend run test:e2e"
  },
  "devDependencies": {
    "dotenv": "^16.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.21.0"
    }
  }
}
