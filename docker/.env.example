# 数据库
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=your-secure-password
DB_NAME=a_signal

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# 火山平台 key
VOLCENGINE_API_KEY=your-key

# ChromaDB Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000
VOLCENGINE_EMBEDDING_MODEL=doubao-embedding-vision-251215

# CORS
CORS_ORIGIN=*

# 后端端口
BACKEND_PORT=3001

# 前端端口
FRONTEND_PORT=8001
